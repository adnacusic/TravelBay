# Kopiraj u .env i popuni stvarnim vrijednostima. .env se NIKAD ne commituje.

# ===== SQL Server =====
# DB_HOST=localhost kad se API pokrece na hostu (dotnet run);
# docker-compose override-uje ovo na DB_HOST=sqlserver za api kontejner.
DB_HOST=localhost
DB_PORT=1435
DB_NAME=220042
DB_SA_PASSWORD=

# ===== JWT =====
JwtToken__Audience=
JwtToken__Issuer=
JwtToken__SecretKey=
JwtToken__DurationInMinutes=30

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ===== API =====
API_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Comma-separated, no wildcard - add your Flutter web/desktop debug origins here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== AI worker (TravelBay.Worker) =====
# Groq API kljuc (https://console.groq.com/keys) za AIAgentKeywords.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# AIAgentSlike koristi Wikimedia Commons API (bez kljuca). Pauza izmedju poziva (pristojnost prema API-ju).
IMAGE_SEARCH_DELAY_SECONDS=3

# ===== Email (SMTP) — "Zaboravljena lozinka" na mobilnoj; salje ga worker =====
# Podrazumijevano: lokalni Mailpit kontejner (docker-compose servis "mailpit") hvata sve emailove,
# web inbox: http://localhost:8025 — radi offline, bez registracije.
# Za pravi SMTP server upisati njegove podatke; SMTP_USE_SSL=true samo za implicitni TLS (port 465),
# inace se STARTTLS koristi automatski kad ga server nudi.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TravelBay <no-reply@travelbay.local>"
SMTP_USE_SSL=false
MAILPIT_WEB_PORT=8025
